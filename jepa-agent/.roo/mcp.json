{
  "mcpServers": {
    "local_router": {
      "command": "python",
      "args": ["-m", "mcp_servers.local_router.server"],
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "HF_HOME": "${workspaceFolder}/models",
        "HF_HUB_CACHE": "${workspaceFolder}/models/hub"
      }
    },
    "code_understanding": {
      "command": "python",
      "args": ["-m", "mcp_servers.code_understanding.server"],
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "HF_HOME": "${workspaceFolder}/models",
        "HF_HUB_CACHE": "${workspaceFolder}/models/hub"
      }
    },
    "semantic_search": {
      "command": "python",
      "args": ["-m", "mcp_servers.semantic_search.server"],
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "HF_HOME": "${workspaceFolder}/models",
        "HF_HUB_CACHE": "${workspaceFolder}/models/hub"
      }
    },
    "obsidian_brain": {
      "command": "python",
      "args": ["-m", "mcp_servers.obsidian_brain.server"],
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "VAULT_PATH": "${workspaceFolder}/vault"
      }
    },
    "cloud_execution": {
      "command": "python",
      "args": ["-m", "mcp_servers.cloud_execution.server"],
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "DEEPSEEK_API_KEY": ""
      }
    },
    "validators": {
      "command": "python",
      "args": ["-m", "mcp_servers.validators.server"],
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    }
  }
}
